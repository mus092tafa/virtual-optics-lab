{
  "appId": "com.mus092tafa.virtualopticslab.student",
  "productName": "Virtual Optics Lab Student",
  "extraMetadata": {
    "edition": "student"
  },
  "files": [
    "dist-student/**",
    "electron/**",
    "!electron/__tests__/**",
    "package.json"
  ],
  "directories": {
    "output": "release/student"
  },
  "win": {
    "target": [
      "portable"
    ],
    "icon": "build/icon.ico",
    "signAndEditExecutable": false
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "VirtualOpticsLab-Student-${version}-setup.exe"
  },
  "portable": {
    "artifactName": "VirtualOpticsLab-Student-${version}-portable.exe"
  },
  "fileAssociations": [
    {
      "ext": "opticsexam",
      "name": "Virtual Optics Lab exam",
      "description": "Virtual Optics Lab exam"
    }
  ]
}
